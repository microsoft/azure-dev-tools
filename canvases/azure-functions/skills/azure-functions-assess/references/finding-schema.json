{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Functions assessment finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "status", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$" },
    "category": { "enum": ["runtime", "language", "programming-model", "extension-bundle", "hosting", "configuration", "code"] },
    "status": { "enum": ["unsupported", "eol-scheduled", "deprecated", "recommended", "problem"] },
    "title": { "type": "string", "maxLength": 200 },
    "detail": { "type": "string", "maxLength": 2000 },
    "evidence": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "maxLength": 300 },
          "line": { "type": "integer", "minimum": 1 },
          "resource": { "type": "string", "maxLength": 300 },
          "property": { "type": "string", "maxLength": 200 },
          "value": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "deadline": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": ["string", "null"], "maxLength": 500 },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["update-scenario", "handoff", "ai-fix", "manual"] },
        "scenarioId": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
